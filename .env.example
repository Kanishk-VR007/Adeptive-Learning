PROJECT_NAME="Adaptive Exam-Prep Tutor"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration (SQLite default, can be PostgreSQL e.g. postgresql+psycopg2://user:pass@localhost:5432/adaptive_learning)
DATABASE_URL="sqlite:///./adaptive_learning.db"

# JWT Security
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local AI Configuration - Model A (Reasoning: DeepSeek via LM Studio)
LMSTUDIO_BASE_URL="http://localhost:1234"
LMSTUDIO_MODEL="oreal-deepseek-r1-distill-qwen-7b"
LMSTUDIO_API_TOKEN=""
LMSTUDIO_CONTEXT_LENGTH=4096
LMSTUDIO_MAX_TOKENS=2048
LMSTUDIO_TEMPERATURE=0.6
LMSTUDIO_GPU_OFFLOAD="max"

# Local AI Configuration - Model B (Formatting: Llama via Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_TOKENS=2048
OLLAMA_TEMPERATURE=0.3
OLLAMA_KEEP_ALIVE="0"

# GPU Execution & Concurrency Manager
GPU_EXECUTION_MODE="sequential"
GPU_PREWARM_MODE="disabled"
MODEL_REQUEST_TIMEOUT=120
MODEL_LOAD_TIMEOUT=180
MODEL_UNLOAD_TIMEOUT=60
GPU_MAX_MEMORY_FRACTION=0.90
GPU_MONITORING_ENABLED=true

# Set to 1 to enable live hardware tests against local GPU
RUN_LOCAL_LLM_INTEGRATION=0
RUN_AGENTIC_LOCAL_INTEGRATION=0

# Adaptive Learning Policy Thresholds
ADAPTIVE_MASTERY_REMEDIATION_THRESHOLD=0.40
ADAPTIVE_MASTERY_PRACTICE_THRESHOLD=0.70
ADAPTIVE_MASTERY_ADVANCE_THRESHOLD=0.90
EVALUATION_CONFIDENCE_THRESHOLD=0.60
LANGGRAPH_CHECKPOINT_DB="sqlite:///./checkpoints.db"

# FSRS Spaced Repetition Configuration
FSRS_DESIRED_RETENTION=0.90
FSRS_ENABLE_FUZZING=true
FSRS_MAXIMUM_INTERVAL=36500
FSRS_DEFAULT_TIMEZONE="UTC"
FSRS_DAILY_NEW_LIMIT=5
FSRS_DAILY_REVIEW_LIMIT=20
